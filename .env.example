# Copy this file to ".env" and fill in the values. ".env" is git-ignored; never commit real secrets.

# --- PostgreSQL (used by the postgres and holdlatch containers) ---
DB_NAME=holdlatch
DB_USER=holdlatch
DB_PASSWORD=change-me-db-password

# --- AeroKV (in-memory hold engine) ---
# Shared password between HoldLatch and AeroKV. Leave empty to run AeroKV without a password (not for production).
AEROKV_PASSWORD=change-me-aerokv-password
# Max entries AeroKV keeps; must comfortably exceed the number of simultaneous holds.
AEROKV_CAPACITY=100000

# --- HoldLatch secrets: each must be at least 32 characters, and different from each other ---
# Signs login tokens.   Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Signs seat-hold tokens.
HOLD_TOKEN_SECRET=change-me-to-another-long-random-string-32-chars

# --- Stripe (optional; without these the payment endpoints answer 503) ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (or the one printed by "stripe listen").
STRIPE_WEBHOOK_SECRET=

# --- Email (optional; without these, order-confirmation emails are only logged) ---
# For Gmail: an "app password" from https://myaccount.google.com/apppasswords, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
